# Шаблон. Настоящий файл: /srv/fakt/validation/runs.env, владелец root, права 0600.
# Значения сгенерируйте на сервере и не вставляйте в чат и в Git:
#   openssl rand -hex 32
WEB_JWT_SECRET=<сгенерировать, 64 символа hex>
ADMIN_LOGIN=<логин первого администратора>
ADMIN_PASSWORD=<длинный пароль, сменить после первого входа>
