# /etc/default/ai-workspace-backup — права 0640 root:root
# Скопировать на сервер после scripts/aws/setup-s3-backup.sh

AI_WORKSPACE_S3_BUCKET=ifinance-ai-panel-backups-eu-north-1
AI_WORKSPACE_S3_PREFIX=prod/ai-panel
AI_WORKSPACE_S3_SSE=AES256
AI_WORKSPACE_BACKUP_PROJECTS=1
AI_WORKSPACE_BACKUP_RETENTION_DAYS=14

# Пути (обычно менять не нужно)
# AI_WORKSPACE_DB=/opt/ai-workspace/data/sessions.db
# AI_WORKSPACE_PROJECTS_DIR=/var/lib/ai-workspace/projects
