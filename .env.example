TELEGRAM_BOT_TOKEN=
# Прокси только для Telegram, если api.telegram.org закрыт: socks5://host:port или http://host:port
TELEGRAM_PROXY_URL=
ALLOWED_USER_IDS=
PROJECTS_DIR=/var/lib/ai-workspace/projects
SESSION_DATABASE_PATH=data/sessions.db

# --- Web UI (optional, only used when web.enabled=true in config.yaml) ---
# WEB_JWT_SECRET=<32-byte hex; e.g. python -c "import secrets;print(secrets.token_hex(32))">
# TELEGRAM_BOT_USERNAME=<your_bot_username_without_@>
# WEB_DEV_BEARER_TOKEN=<v1-only: any random string for SSH-tunnel auth without HTTPS>

# --- База знаний проекта: адрес MCP-сервера и ключ ---
# Пусто значит выключено. Адрес только https://, http допустим лишь для 127.0.0.1.
# Значение ключа не коммитить.
KB_MCP_URL=
KB_MCP_KEY=
